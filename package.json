{
  "name": "dsh-entry-shaper",
  "version": "0.9.0",
  "description": "入口塑造（payload shaping）：在元素被首次发送之前定型，使 payload 前缀永远单调 ⇒ 零断点税。当前只做「摘掉 assistant 消息里的 reasoning 块」。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "keywords": [
    "dsh",
    "dsh-plugin",
    "payload",
    "prefix-cache",
    "reasoning"
  ],
  "scripts": {
    "test": "node test/run-all.mjs",
    "test:ci": "node --test test/",
    "check": "node --check index.js && node --check test/shaping.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "docs/"
  ]
}
