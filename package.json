{
  "name": "dsh-entry-shaper",
  "version": "1.0.6",
  "description": "入口塑造（payload shaping）：按类别给会话元素排 op 链（reasoning / toolResult / toolArgs / assistantText），在元素被首次发送前定型；代理通道在 wire 层塑形 ⇒ 前缀单调、零断点税。塑形结果不带任何标记（标记会污染模型，见 docs/POLLUTION.md），推理原文可在侧路寄存表里回溯。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "MaudieHakimi (https://github.com/MaudieHakimi)",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "payload",
    "context",
    "prefix-cache",
    "prompt-cache",
    "reasoning",
    "token-saving",
    "cost-optimization"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaudieHakimi/dsh-entry-shaper.git"
  },
  "homepage": "https://github.com/MaudieHakimi/dsh-entry-shaper#readme",
  "bugs": {
    "url": "https://github.com/MaudieHakimi/dsh-entry-shaper/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node test/run-all.mjs",
    "test:ci": "node --test test/",
    "check": "node --check index.js && node --check test/shaping.test.mjs",
    "prepublishOnly": "node --check index.js && node test/run-all.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "docs/",
    "examples/",
    "tools/"
  ]
}
